<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>OpcDaToUaGateway.Keygen</RootNamespace>
    <AssemblyName>OpcDaToUaGateway.Keygen</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>..\opc-da-opc-ua.ico</ApplicationIcon>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <Company>OPC DA to UA Gateway</Company>
    <Product>OPC DA to OPC UA Gateway Keygen</Product>
    <Description>OPC DA to UA Gateway 授权码计算工具</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!-- 共享主程序的授权算法文件（链接引用，编译时自动同步） -->
  <ItemGroup>
    <Compile Include="..\Models\LicenseAlgorithm.cs" Link="LicenseAlgorithm.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI 硬件信息查询（PCID 生成需要）-->
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
